# Firebase web app settings (Firebase console → Project settings → Your apps).
# Copy this file to .env.local and fill the values in. .env.local is not committed.
# Also turn on Authentication → Sign-in method → Email/Password, then restart `npm run dev`.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
