# Firebase web app settings (Firebase console → Project settings → Your apps → rhymnast → SDK setup).
# Copy this file to .env (or .env.local) and fill in the values. .env and .env.local are not committed.
# These four are public web settings (the browser receives them), but keep them out of git anyway.
# Never put server secrets in any env file the browser can read (service account keys, firebase-admin).
# Deploys build on your computer (`npm run deploy`), so the live site uses the values in your .env.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
